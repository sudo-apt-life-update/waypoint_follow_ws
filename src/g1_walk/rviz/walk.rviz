Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Planned Path1
        - /Commanded Odom1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: odom
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
    # The path as written in the YAML. Nominal -- the robot is not measured
    # against it, and open loop it will not track it exactly.
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: /path_follower/planned_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 255; 60
      Line Style: Lines
      Alpha: 1
    # The integral of what we commanded. Also nominal: it cannot see slip.
    - Class: rviz_default_plugins/Odometry
      Name: Commanded Odom
      Enabled: true
      Topic:
        Value: /path_follower/commanded_odom
        Depth: 20
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Alpha: 1
        Color: 255; 170; 0
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Value: Arrow
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Focal Point:
        X: 1
        Y: 0
        Z: 0.5
      Pitch: 0.5
      Yaw: 2.4
      Target Frame: odom
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
  Displays:
    collapsed: false
  Views:
    collapsed: false
